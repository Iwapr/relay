{
  "name": "remote-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "agent": "tsx apps/agent/src/main.ts",
    "gateway": "tsx apps/gateway/src/main.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "diagnose": "tsx scripts/diagnose.ts",
    "setup": "tsx scripts/setup.ts",
    "format": "prettier --write apps packages scripts tests docs/*.md README.md tsconfig.json package.json playwright.config.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "probe": "tsx scripts/probe-codex.ts",
    "smoke:live": "tsx scripts/smoke-live.ts --run",
    "service:install": "tsx scripts/install-service.ts",
    "service:uninstall": "tsx scripts/uninstall-service.ts",
    "backup": "tsx scripts/backup-database.ts",
    "release": "tsx scripts/release.ts",
    "lan": "tsx scripts/lan.ts",
    "tailscale": "tsx scripts/tailscale.ts",
    "docs:media": "bash scripts/record-media.sh",
    "install:gemini": "tsx scripts/install-gemini.ts",
    "install:deepseek": "tsx scripts/install-deepseek.ts",
    "install:factory": "tsx scripts/install-factory.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.280",
    "@factory/droid-sdk": "0.9.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.4",
    "@moonshot-ai/kimi-code": "2.0.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "chokidar": "5.0.0",
    "fastify": "5.12.5",
    "highlight.js": "11.12.0",
    "katex": "0.16.47",
    "lucide-react": "1.47.0",
    "mime-types": "3.0.2",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/katex": "0.16.8",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "node": "24.21.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
